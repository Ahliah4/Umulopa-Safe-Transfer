# ============================================
# UMOYOLINK FRONTEND ENVIRONMENT VARIABLES
# Copy this file to .env and adjust values
# ============================================

# ============================================
# API Configuration
# ============================================

# Backend API URL - NO /api suffix
VITE_API_URL=http://localhost:5000

# API Timeout (milliseconds)
VITE_API_TIMEOUT=60000

# ============================================
# App Configuration
# ============================================

VITE_APP_NAME=UmoyoLink
VITE_APP_VERSION=1.0.0
VITE_NODE_ENV=development

# ============================================
# Authentication
# ============================================

VITE_TOKEN_KEY=umoyolink_token
VITE_REFRESH_TOKEN_KEY=umoyolink_refresh_token
VITE_USER_KEY=umoyolink_user

# ============================================
# Feature Flags
# ============================================

VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ALERTS=true
VITE_ENABLE_REPORTS=true
VITE_ENABLE_DONOR_MODULE=true
VITE_ENABLE_BLOOD_BANK=true
VITE_ENABLE_PATIENT_MODULE=true

# ============================================
# Pagination Defaults
# ============================================

VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# ============================================
# File Upload
# ============================================

VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,pdf

# ============================================
# Development Settings (set VITE_DEBUG=false to silence console logging)
# ============================================

VITE_DEBUG=true
VITE_MOCK_API=false
VITE_ENABLE_LOGGING=true
VITE_SHOW_CORS_ERRORS=true
